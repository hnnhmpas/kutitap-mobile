rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only a signed-in user can read/write the tracker data.
    // For extra safety, replace `request.auth != null` with `request.auth.uid == "YOUR_UID"`.
    match /financeTracker/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
